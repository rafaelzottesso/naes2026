# Copie este arquivo para .env e preencha. O .env não vai para o Git nem para o deploy.

# Modo escolhido: enterprise (Vertex AI), com a mesma conta de faturamento do App Engine.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Modo API Key (alternativo): apague ou comente o bloco acima e descomente a linha abaixo.
# GEMINI_API_KEY=

# Segredo do endpoint de manutenção (/ia/manutencao/). Use um valor longo e aleatório.
TAREFAS_SEGREDO=